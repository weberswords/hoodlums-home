{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/consultation", "destination": "/", "permanent": true },
    { "source": "/inspiration", "destination": "/", "permanent": true },
    { "source": "/learn-with-the-hoodlums", "destination": "/", "permanent": true },
    { "source": "/pomodoro-method-canvas", "destination": "https://blog.theintelligenthoodlums.com/p/pomodoro-method-canvas", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
